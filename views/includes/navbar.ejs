
<style>
  .search-btn{
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
  }

  .search-btn:active{
    opacity: 0.5;
  }

  .search-inp {
    border-radius: 25px;
    padding: 0.5rem 0rem 0.5rem 2rem;
  }
</style>




<nav class="navbar sm:navbar-expand md-1 fg-2 border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <button 
      class="btn-icon navbar-toggler" 
      type="button"
      data-bs-toggle="drawer" 
      data-bs-target="#navbarNavAltMarkup">

      <span class="navbar-toggler-icon" aria-hidden="true"></span>
    </button>

    <dialog class="drawer drawer-end" tabindex="-1"
          id="navbarNavAltMarkup" 
          aria-labelledby="navbarNavAltMarkupLabel">

      <div class="drawer-header">
        <h5 class="drawer-title" 
        id="navbarNavAltMarkupLabel">Menu</h5>

        <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close"></button>
      </div>


      <div class="drawer-body">
        <div class="nav nav-pills navbar-nav">
          <a class="nav-link" href="/listings">Explore</a>
        </div>

        <div class="navbar-nav mx-auto">
          <nav class="navbar bg-1 fg-2">
       <div class="container-fluid">
        <form class="d-flex" role="search">

          <input class="form-control me-2 rounded-pill search-inp"
           style="width: 200px;"
            type="search" placeholder="Search Destinations" 
            aria-label="Search"/>


          <button class="btn search-btn" 
          type="submit">
            <i class="fa-solid fa-magnifying-glass"></i>Search
          </button>
        </form>
      </div>

        </div>

        <div class="nav nav-pills navbar-nav ms-auto">
           <a class="nav-link" href="/listings/new">Airbnb your home</a>
          <% if(!currUser) { %>
          <a class="nav-link" href="/signup"><b>Sign up</b></a>
          <a class="nav-link" href="/login"><b>Login</b></a>
          <% } %>

           <% if(currUser) { %>
          <a class="nav-link" href="/logout"><b>Log out</b></a>
           <% } %>
        </div>


      </div>
    </dialog>
  </div>
</nav>