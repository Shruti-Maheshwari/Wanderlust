<% layout("layouts/boilerplate") %>

<div class="row mt-3">
<h1 class="col-6 offset-3"> Singup on Wanderlust </h1>

        <div class="col-6 offset-3">
            <form action= "/signup" method="post" novalidate class="needs-validation" data-bs-validate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input type="text" name="username" class="form-control" required id="username">
                    <div class="valid-feedback">Looks good!</div>
                    <div class="invalid-feedback">Please enter a username.</div>
                </div>


                <div class="mb-3">
                    <label for="email" class="form-label">E-mail</label>
                    <input type="email" name="email" class="form-control" required id="email">
                </div>

                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" name="password" class="form-control" required id="password">
                </div>

                <button class="btun btn-success">Signup</button>

            </form>
        </div>
</div>